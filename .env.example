# Copie este arquivo para ".env" e preencha os valores abaixo.

# Sua chave gratuita da API do Gemini (Google AI).
# Obtenha em https://aistudio.google.com/apikey — não pede cartão de crédito.
GEMINI_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Chave secreta usada pelo Flask para assinar o cookie de sessão.
# Pode ser qualquer string aleatória; troque por uma própria.
FLASK_SECRET_KEY=troque-esta-chave-por-algo-aleatorio

# (Opcional) Modelo do Gemini a usar. Padrão: gemini-3.6-flash
# Veja modelos disponíveis em https://aistudio.google.com
SAMANTAH_MODEL=gemini-3.6-flash

# (Opcional) Porta do servidor local. Padrão: 5000
PORT=5000

# (Opcional) Desliga o modo debug do Flask (use "false" em produção).
FLASK_DEBUG=true

# (Opcional) Caminho do arquivo do banco SQLite local. Só é usado se
# TURSO_DATABASE_URL (abaixo) não estiver configurada.
SAMANTAH_DB_PATH=samantah.db

# (Opcional, recomendado em produção) Banco de dados hospedado no Turso —
# gratuito, sem cartão de crédito — para o login e a memória sobreviverem a
# deploys e a períodos em que o servidor "dorme" (ex: no plano gratuito do
# Render). Se deixar em branco, a Samantah usa o SQLite local (SAMANTAH_DB_PATH)
# em vez disso. Crie sua conta e banco em https://turso.tech e pegue esses
# dois valores no painel do banco ("Connect" / "Create Token").
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
