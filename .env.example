# Copie este arquivo para ".env" e preencha os valores abaixo.

# Sua chave gratuita da API do Gemini (Google AI).
# Obtenha em https://aistudio.google.com/apikey — não pede cartão de crédito.
GEMINI_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Chave secreta usada pelo Flask para assinar o cookie de sessão.
# Pode ser qualquer string aleatória; troque por uma própria.
FLASK_SECRET_KEY=troque-esta-chave-por-algo-aleatorio

# (Opcional) Modelo do Gemini a usar. Padrão: gemini-2.5-flash
# Veja modelos disponíveis em https://aistudio.google.com
SAMANTAH_MODEL=gemini-2.5-flash

# (Opcional) Porta do servidor local. Padrão: 5000
PORT=5000

# (Opcional) Desliga o modo debug do Flask (use "false" em produção).
FLASK_DEBUG=true

# (Opcional) Caminho do arquivo do banco SQLite. Em produção com disco
# persistente no Render, aponte para dentro do disco montado, ex: /data/samantah.db
SAMANTAH_DB_PATH=samantah.db
